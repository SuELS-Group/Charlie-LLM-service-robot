<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>action_service</name>
    <version>0.0.0</version>
    <description>High-level action service providing commands like find, pick and deliver for the robot.</description>
    <maintainer email="pg-llm-service-robot@uni-oldenburg.de">pg-llm-service-robot</maintainer>
    <license>AGPL-3.0-only</license>

    <exec_depend>action_interfaces</exec_depend>
    <depend>ament_index_python</depend>
    <depend>command_interfaces</depend>
    <depend>control_msgs</depend>
    <depend>global_stop</depend>
    <depend>geometry_msgs</depend>
    <depend>python3-yaml</depend>
    <depend>rclpy</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>
    <depend>std_srvs</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>tool_status</depend>
    <depend>trajectory_msgs</depend>
    <depend>vision_msgs</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
