<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>camera_node</name>
    <version>0.0.0</version>
    <description>Camera node providing image and camera info topics from the robot cameras.</description>
    <maintainer email="pg-llm-service-robot@uni-oldenburg.de">pg-llm-service-robot</maintainer>
    <license>AGPL-3.0-only</license>

    <exec_depend>cv_bridge</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>python3-numpy</exec_depend>
    <exec_depend>python3-opencv</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>rcl_interfaces</exec_depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>realsense2_camera</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
