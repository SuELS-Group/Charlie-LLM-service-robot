<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>command_node</name>
    <version>0.0.0</version>
    <description>Node that translates LLM commands into robot actions and reports robot status.</description>
    <maintainer email="pg-llm-service-robot@uni-oldenburg.de">pg-llm-service-robot</maintainer>
    <license>AGPL-3.0-only</license>

    <exec_depend>action_msgs</exec_depend>
    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>command_interfaces</exec_depend>
    <exec_depend>control_msgs</exec_depend>
    <exec_depend>global_stop</exec_depend>
    <exec_depend>geometry_msgs</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>nav2_msgs</exec_depend>
    <exec_depend>python3-psutil</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>action_interfaces</exec_depend>
    <exec_depend>rviz2</exec_depend>
    <exec_depend>slam_toolbox</exec_depend>
    <exec_depend>std_msgs</exec_depend>
    <exec_depend>std_srvs</exec_depend>
    <exec_depend>stretch_nav2</exec_depend>
    <exec_depend>tf2_geometry_msgs</exec_depend>
    <exec_depend>tf2_ros</exec_depend>
    <exec_depend>tool_status</exec_depend>
    <exec_depend>trajectory_msgs</exec_depend>
    <exec_depend>waypoint_interfaces</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
