<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>waypoint_node</name>
    <version>0.0.0</version>
    <description>Node for saving and managing persistent waypoints.</description>
    <maintainer email="pg-llm-service-robot@uni-oldenburg.de">pg-llm-service-robot</maintainer>
    <license>AGPL-3.0-only</license>

    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>std_msgs</exec_depend>
    <exec_depend>tf2_ros</exec_depend>
    <exec_depend>tool_status</exec_depend>
    <exec_depend>visualization_msgs</exec_depend>
    <exec_depend>waypoint_interfaces</exec_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
